# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=https://hfaryhdnwhwvsiootewc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_avRJJGqM1ikliXbdzkzymA_S_w-nf0r

# Admin endpoints (/api/demo-requests, /api/analytics/visitors)
# Both must be set or those endpoints refuse with 503. Never expose the
# service-role key to the browser - it bypasses Row Level Security.
ADMIN_API_KEY=generate-a-long-random-string
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave unset for same-origin only, which is correct when this app serves the site.
# ALLOWED_ORIGIN=https://example.com

# Email Configuration (for demo request and contact notifications)
# Sent via the Resend HTTPS API, not SMTP: Render's free plan blocks outbound
# SMTP ports (25, 465, 587), so any SMTP client just times out.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Where notifications land. Until you verify your own domain with Resend, this
# must be the address your Resend account is registered with.
TEAM_EMAIL=you@example.com

# Optional. Defaults to Resend's shared sender, which needs no domain setup.
# Once you verify a domain, change this to e.g. "HealthOS <hello@yourdomain.com>"
# MAIL_FROM=HealthOS <onboarding@resend.dev>

# Database Configuration
DATABASE_PASSWORD=your-database-password
